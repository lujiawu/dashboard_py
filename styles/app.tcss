/* styles/app.tcss */

#main-layout {
    height: 100%;
}

#top-row {
    height: 10;
}
#top-row > #ai-agents {
    width: 3fr;
}
#top-row > #top-attributes {
    width: 1fr;
}

#middle-row {
    height: 10;
}

#todo-list {
    height: 1fr;
}

.panel {
    border: solid $primary;
    padding: 0 0;
    height: 100%;
}

GoalProgressPanel {
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

GoalProgressPanel > Static {
    width: 100%;
}

DataTable {
    height: 100%;
}
