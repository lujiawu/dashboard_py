/* ===== 整体布局 ===== */
#main-layout {
    height: 100%;
}

#top-row {
    height: 10;
}
#middle-row {
    height: 10;
}
#bottom-row {
    height: 1fr;
}

/* ===== 列宽分配 ===== */
#top-row > #ai-agents {
    width: 3fr;
}
#top-row > #top-attributes {
    width: 1fr;
}

#middle-row > #todo-list{
    width: 3fr;
}

#middle-row > #goal-progress{
    width: 2fr;
}

/* ===== 统一 panel 样式 ===== */
.panel {
    border: solid $primary;
    padding: 0 0;
    height: 100%;
}

/* ===== 特定 widget 微调 ===== */
GoalProgressPanel {
    padding: 0 1;
}
GoalProgressPanel > Static {
    width: 100%;
}

#todo-list DataTable {
    height: 1fr;
}

#todo-list Input {
    height: 1;
    border: none;
    padding: 0 1;
}
