/* ===== 整体布局 ===== */
#main-layout {
    height: 100%;
}

#top-row {
    height: 10;
}
#middle-row {
    height: 10;
}
#bottom-row {
    height: 1fr;
}

/* ===== 列宽分配 ===== */
#top-row > #ai-agents {
    width: 3fr;
}
#top-row > #dws-info {
    width: 2fr;
}

#middle-row > #todo-list{
    width: 3fr;
}

#middle-row > .side-panel {
    width: 2fr;
}

.hidden {
    display: none;
}

#bottom-row > #git-status {
    width: 1fr;
    height: auto;
}
#bottom-row > #bottom-area {
    width: 3fr;
    height: 1fr;
}

/* ===== 统一 panel 样式 ===== */
.panel {
    border: solid $surface-lighten-2;
    padding: 0 1;
    height: 100%;
}

.panel:focus, .panel:focus-within {
    border: solid $text-accent;
}

#ai-agents.panel {
    border: solid $primary;
}

#todo-list.panel {
    border: solid $warning;
}

#dws-info.panel {
    border: solid $success;
}

#git-status.panel {
    border: solid $error;
}

#bottom-area.panel {
    border: none;
    background: $surface;
    padding: 0 1;
}

/* ===== 特定 widget 微调 ===== */
GoalProgressPanel {
    padding: 0 1;
}
GoalProgressPanel > Static {
    width: 100%;
}

YunxiaoPanel {
    padding: 0 1;
}
YunxiaoPanel DataTable {
    height: 1fr;
}

#todo-list DataTable {
    height: 1fr;
}

#todo-list Input {
    height: 1;
    border: none;
    padding: 0 1;
}
