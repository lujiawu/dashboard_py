/* ===== 整体布局 ===== */
#main-layout {
    height: 100%;
    layers: base overlay;
}

#top-row {
    height: 2fr;
    layer: base;
}
#bottom-row {
    height: 1fr;
    min-height: 5;
    layer: base;
}

RowDivider {
    height: 1;
    background: transparent;
    layer: overlay;
    position: absolute;
}

/* ===== 列宽分配 ===== */
#top-row > #todo-list{
    width: 1fr;
}

#top-row > #chat {
    width: 1fr;
}

ColumnDivider {
    width: 1;
    height: 100%;
    background: transparent;
}

ColumnDivider:hover {
    background: $primary;
}

.hidden {
    display: none;
}

#bottom-row > #git-status {
    width: 1fr;
    height: auto;
}
#bottom-row > #yunxiao {
    width: 4fr;
    height: 1fr;
}

/* ===== 统一 panel 样式 ===== */
.panel {
    border: solid $surface-lighten-2;
    padding: 0 1;
    height: 100%;
}

#todo-list.panel {
    border: solid $warning;
}
#todo-list.panel:focus, #todo-list.panel:focus-within {
    border: solid $text-accent;
}

#git-status.panel {
    border: solid $error;
    padding: 1 2;
}
#git-status.panel:focus, #git-status.panel:focus-within {
    border: solid $text-accent;
}

#yunxiao.panel {
    border: solid $secondary;
}
#yunxiao.panel:focus, #yunxiao.panel:focus-within {
    border: solid $text-accent;
}

#chat > #chat-conversations {
    width: 3fr;
}

#chat > #chat-conversation-pane {
    width: 5fr;
}

#chat-messages {
    height: 1fr;
    padding: 0 1;
}

#chat-input {
    height: 3;
}

#chat-status {
    height: 1;
    padding: 0 1;
}
YunxiaoPanel DataTable {
    height: 1fr;
}

#todo-list DataTable {
    height: 1fr;
}

#todo-list Input {
    height: 1;
    border: none;
    padding: 0 1;
}
